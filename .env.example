# Opzionale: copia in .env solo se vuoi cambiare questi valori.

# Porta esposta sull'host.
YOMI_PORT=8080

# Interfaccia: 0.0.0.0 = raggiungibile dalla rete,
# 127.0.0.1 = solo locale (usa questo dietro Caddy/nginx sullo stesso host).
YOMI_BIND=0.0.0.0

# Solo se MangaWorld cambia dominio (es. https://www.mangaworld.mx).
# MANGAWORLD_BASE=
